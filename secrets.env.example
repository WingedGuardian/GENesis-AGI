# Genesis — Secrets Template
# Copy and fill in your values:
#   cp secrets.env.example secrets.env
#   chmod 600 secrets.env
#
# This file contains credentials, API keys, and runtime config.
# For full documentation of each key, see the comments in secrets.env.

# ─── Telegram ────────────────────────────────────────────────────────────
# Required for the Telegram bridge. Create a bot via @BotFather.
# TELEGRAM_BOT_TOKEN: paste the token from BotFather (format: 123456:ABC-DEF...)
# TELEGRAM_ALLOWED_USERS: comma-separated numeric user IDs (NOT the bot token).
#   Get your ID: message @userinfobot on Telegram.
# TELEGRAM_FORUM_CHAT_ID: optional supergroup chat ID for topic routing (negative number)

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_FORUM_CHAT_ID=

# ─── LLM Providers (Core) ───────────────────────────────────────────────
# At minimum, configure one provider. All are optional individually.

# --- Groq ---
# Used by: 13+ call sites — triage, reflection, tagging, STT (Whisper).
# Signup: console.groq.com
# Free tier: 30 RPM on llama-3.3-70b-versatile
API_KEY_GROQ=

# --- Mistral ---
# Used by: 19 call sites — reflection, triage calibration, embeddings.
# Signup: console.mistral.ai
# Free tier: limited RPM on mistral-large-latest
API_KEY_MISTRAL=

# --- Google (Gemini) ---
# Used by: 12 call sites — consolidation, surplus, outreach, research.
# Signup: console.cloud.google.com -> APIs & Services -> Credentials
# Free tier: Gemini Flash generous free quota
GOOGLE_API_KEY=

# --- OpenRouter ---
# Used by: 16+ call sites. Model aggregator — one key covers 200+ models.
# Signup: openrouter.ai/keys
# Free tier: access to community free models
API_KEY_OPENROUTER=

# --- Anthropic (Claude API) ---
# Used by: Claude Code background sessions (not LiteLLM routing).
# All LiteLLM call sites now route Claude models through OpenRouter.
# Signup: console.anthropic.com
# Paid: per-token pricing
ANTHROPIC_API_KEY=

# --- DeepSeek ---
# Used by: Direct provider (deepseek-chat). Available for call site chains.
# Signup: platform.deepseek.com
# Paid: very cheap per-token pricing
API_KEY_DEEPSEEK=

# --- Alibaba (Qwen) ---
# Used by: 5 call sites — retrospective, calibration, meta prompting.
# Signup: dashscope.console.aliyun.com
# Paid: cheap per-token
API_KEY_QWEN=

# --- ZenMux (GLM-5 via aggregator) ---
# Used by: 2 call sites — cognitive state, contingency reflection.
# Signup: zenmux.ai -> Dashboard -> API Keys
# Paid: aggregator markup. OpenAI-compatible.
API_KEY_ZENMUX=

# --- MiniMax ---
# Used by: Provider configured, available for call site chains.
# Signup: platform.minimaxi.com -> API Keys
# Paid: ~$0.29/M input, ~$1.15/M output. OpenAI-compatible.
API_KEY_MINIMAX=

# ─── LLM Providers (Additional) ─────────────────────────────────────────
# Routing support exists for these providers. Leave empty to disable.

# --- OpenAI ---
# Used by: Direct provider (openai-gpt5). Also available via OpenRouter.
# Signup: platform.openai.com
OPENAI_API_KEY=

# --- xAI (Grok) ---
# Used by: Direct provider (xai-grok). Available for call site chains.
# Signup: console.x.ai
API_KEY_XAI=

# --- NVIDIA NIM ---
# Used by: nvidia-nim-deepseek (DeepSeek V4 Flash 0731).
# Free tier: ~40 RPM per model. No credit card.
# Signup: build.nvidia.com -> Get API Key
API_KEY_NVIDIA_NIM=

# --- Voyage AI ---
# Used by: Reranking (rerank-2.5) for memory recall pipeline. 200M free tokens.
# Embeddings also available (1024D compatible) but not wired yet.
# Signup: dash.voyageai.com
API_KEY_VOYAGE=

# --- Cerebras ---
# Used by: High-volume free inference (14,400 RPD). Qwen3-235B instruct.
# Signup: cloud.cerebras.ai
# Free tier: 10 RPM, 14,400 RPD, 1M tokens/min
API_KEY_CEREBRAS=

# --- GitHub Models ---
# Used by: Free frontier reasoning (o3-mini 50 RPD). Azure-backed.
# Signup: github.com/marketplace/models (GitHub account required)
# Free tier: varies by model — o3-mini: 50 RPD
API_KEY_GITHUB=

# --- SambaNova ---
# Used by: Free inference (DeepSeek-R1, QwQ-32B). Custom hardware.
# Signup: cloud.sambanova.ai
# Free tier: generous limits, verify current terms
API_KEY_SAMBANOVA=

# --- Azure OpenAI ---
# Used by: Available for routing. For enterprise/Azure users.
# Signup: portal.azure.com -> Azure OpenAI Service
API_KEY_AZURE=

# --- AWS Bedrock ---
# Used by: Available for routing. For AWS users.
# Signup: aws.amazon.com -> Bedrock
API_KEY_BEDROCK=

# --- HuggingFace ---
# Used by: Available for model access and embeddings.
# Signup: huggingface.co/settings/tokens
API_KEY_HUGGINGFACE=

# ─── Search & Research ───────────────────────────────────────────────────

# --- Brave Search ---
# Used by: Web search fallback.
# Signup: brave.com/search/api
# Free tier: 2,000 queries/month
API_KEY_BRAVE=

# --- Perplexity ---
# Used by: Research provider for orchestrated research (Sonar API).
# Signup: perplexity.ai/settings/api
# Paid: ~$0.006/query (Sonar), $0.005/query (Search API)
API_KEY_PERPLEXITY=

# --- Tavily ---
# Used by: AI-optimized web search for agent pipelines.
# Signup: app.tavily.com (no credit card required)
# Free tier: 1,000 searches/month
API_KEY_TAVILY=

# --- Exa ---
# Used by: Neural/semantic web search + answer generation.
# Signup: dashboard.exa.ai (no credit card required)
# Free tier: 1,000 searches/month
API_KEY_EXA=

# --- Firecrawl ---
# Used by: Claude Code Firecrawl plugin.
# Signup: firecrawl.dev
FIRECRAWL_API_KEY=

# --- Cloudflare ---
# Used by: Web crawling provider. Requires both key and account ID.
# Signup: dash.cloudflare.com -> API Tokens
API_KEY_CLOUDFLARE=
CLOUDFLARE_ACCOUNT_ID=

# ─── TTS & Voice ─────────────────────────────────────────────────────────
# All optional. Set TTS_ENABLED=false to disable voice responses entirely.

TTS_ENABLED=true

# --- ElevenLabs ---
# Signup: elevenlabs.io -> Profile -> API Keys
API_KEY_ELEVENLABS=
TTS_VOICE_ID_ELEVENLABS=
TTS_ELEVENLABS_MODEL=eleven_flash_v2_5
# TTS_ELEVENLABS_STABILITY=0.25
# TTS_ELEVENLABS_SIMILARITY=0.20
# TTS_ELEVENLABS_STYLE=1.0
# TTS_ELEVENLABS_SPEED=1.0

# --- Cartesia Sonic ---
# Signup: cartesia.ai -> Dashboard -> API Keys
API_KEY_CARTESIA=
TTS_VOICE_ID_CARTESIA=

# --- Fish Audio ---
# Signup: fish.audio -> API Keys
API_KEY_FISH_AUDIO=
TTS_VOICE_ID_FISH=

# ─── Embeddings ──────────────────────────────────────────────────────────

# --- DeepInfra ---
# Used by: Cloud embedding fallback.
# Signup: deepinfra.com -> API Keys
API_KEY_DEEPINFRA=

# ─── Document Intelligence ───────────────────────────────────────────────

# --- PageIndex ---
# Used by: Tree-based document indexing for long structured PDFs.
# Signup: dash.pageindex.ai -> API Keys
# Free tier available.
API_KEY_PAGEINDEX=

# ─── Dashboard Security ──────────────────────────────────────────────────
# Set a password to protect the dashboard from unauthorized LAN access.
# Leave empty to disable auth (dashboard accessible without login).
# When set, all dashboard access requires login (30-day session cookie), AND
# state-changing API calls (/api/** POST/PUT/DELETE/PATCH) require that login
# session or a bearer token — so the secrets/config endpoints are no longer
# reachable unauthenticated. Read-only GETs, /v1/* (own token), and trusted
# loopback callers are unaffected.

DASHBOARD_PASSWORD=

# Escape hatch: set to "off" to disable ONLY the /api mutation gate above (the
# HTML login still applies) if an unforeseen local integration breaks. Default
# on whenever DASHBOARD_PASSWORD is set.
# GENESIS_DASHBOARD_API_AUTH=on

# ─── Infrastructure & Config ─────────────────────────────────────────────
# Runtime config, not secrets. Will move to dashboard settings in a future release.

# Local inference servers
OLLAMA_URL=http://localhost:11434
GENESIS_ENABLE_OLLAMA=false
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_HEALTH_URL=http://localhost:1234/v1/models

# Bridge config
WHISPER_MODEL=whisper-large-v3
DAY_BOUNDARY_HOUR=0

# HTTP API auth
# Used by: MCP HTTP transport, Voice API (/v1/voice/* incl. the graduation
# write endpoint). Fail-closed everywhere: when empty, all /v1/voice/* routes
# answer 503 (a boot-time warning is logged) and the HTTP MCP transport
# refuses to start. Set to a strong random token to enable them.
GENESIS_MCP_HTTP_TOKEN=

# Home Assistant (outbound voice TTS + Voice PE hardware vitals)
# Used by: VoiceChannelAdapter (Genesis speaking through HA speakers) and the
#   dashboard Device tab (channels/voice/pe_vitals — reads Voice PE health sensors).
# HA_URL: Home Assistant base URL reachable from the Genesis container.
# HA_LONG_LIVED_TOKEN: Generated via HA UI (Profile → Security → Long-lived access tokens)
#   or via WebSocket API. Required for outbound TTS calls + vitals polling.
# HA_VOICE_PE_PREFIX: entity-id prefix of the Voice PE ESPHome device — the
#   install-specific device id in the middle, kept OUT of committed source (same
#   invariant as HA_MEDIA_PLAYER_ENTITY). e.g. home_assistant_..._voice_<id>_ so the
#   Device tab reads sensor.<prefix>internal_temperature, sensor.<prefix>wifi_signal, …
HA_URL=
HA_LONG_LIVED_TOKEN=
HA_VOICE_PE_PREFIX=

# Discord (optional — for campaign posting via webhooks)
DISCORD_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_DEV_DISCUSSION=
DISCORD_WEBHOOK_SHOWCASE=
DISCORD_WEBHOOK_GETTING_STARTED=

# User preferences
# USER_TIMEZONE: DEPRECATED fallback. The authoritative timezone source is the
#   `timezone:` key in ~/.genesis/config/genesis.yaml (editable live from the
#   dashboard Configuration tab). This env var is consulted ONLY when that file
#   has no `timezone`. Prefer setting the timezone in genesis.yaml.
USER_TIMEZONE=UTC

# ─── Backup ──────────────────────────────────────────────────────────────
# Used by: scripts/backup.sh — encrypted backup to your private backups repo.
# Editable from the dashboard Backup tab. The cron SCHEDULE is managed
# separately (scripts/manage_backup_cron.sh), not stored here.
# --- Encryption ---
# Used by: GPG passphrase for all encrypted payloads (REQUIRED — without it
# SQLite/Qdrant/memory/transcripts/secrets are skipped). Rotating it does NOT
# re-encrypt existing history; keep the old passphrase until a new backup runs.
GENESIS_BACKUP_PASSPHRASE=
# --- Destination ---
# Used by: Git URL of your private backups repo (auto-detected from the
# existing clone if blank). Changing it does NOT migrate existing history.
GENESIS_BACKUP_REPO=
# --- Off-site (Tier 2) ---
# Used by: off-site backend selector — none | local | smb
GENESIS_BACKUP_TIER2_BACKEND=
# Used by: local backend — a mounted dir / other-host filesystem path
GENESIS_BACKUP_LOCAL_PATH=
# Used by: smb backend — //host/share
GENESIS_BACKUP_NAS=
# Used by: smb backend — share username
GENESIS_BACKUP_NAS_USER=
# Used by: smb backend — share password
GENESIS_BACKUP_NAS_PASS=

# ─── Email (Gmail IMAP) ──────────────────────────────────────────────────
# Used by: Mail monitor (genesis/mail/) — polls inbox for AI newsletters,
#   announcements, and research; feeds the recon pipeline.
# Setup: enable 2FA on the Gmail account, then generate an App Password at
#   myaccount.google.com/apppasswords (this is NOT the account login password).
GENESIS_GMAIL_ADDRESS=
GENESIS_GMAIL_APP_PASSWORD=

# ─── Browser / Web Automation ────────────────────────────────────────────
# --- TinyFish ---
# Used by: web_fetch anti-bot cloud backend, web_agent, and browser tinyfish=True.
# Signup: tinyfish.ai
API_KEY_TINYFISH=
# GENESIS_CDP_URL: remote CDP browser endpoint (browser_navigate remote=True) —
#   e.g. the user's real Chrome over Tailscale at http://<tailscale-ip>:9222. Optional.
GENESIS_CDP_URL=

# ─── LLM Providers (extra) ───────────────────────────────────────────────
# --- Zhipu / Z.ai (GLM) ---
# NOTE FOR EDITORS: this file is a PARSED REGISTRY, not prose. The dashboard's
# Provider Keys panel builds itself from it (dashboard/routes/secrets.py
# `_parse_example_file`). `# Used by:` becomes the description and `# Signup:`
# becomes a link the template renders as "https://" + the value, so that field
# must be a BARE HOST — free text there ships a dead hyperlink. Both fields reset
# after every KEY=, so each key needs its own pair. Verify edits by running the
# parser, not by reading.
#
# The split that matters: a CODING-PLAN key for the Anthropic-protocol coding
# endpoints, and a GENERAL/prepaid key for the general endpoint. Using the wrong
# one returns "1113 Insufficient balance" even on a funded account, because they
# bill different products. GLM ships on TWO PLATFORMS (z.ai international,
# bigmodel.cn China) and a Coding Plan is bought PER PLATFORM, so a coding key is
# NOT portable between them — hence a separate slot for each.
#
# Used by: nothing in this repo today — a general-endpoint (/api/paas/v4) peer
#   you wire yourself. The router has no zhipu/z.ai provider (its `glm51` entry
#   is a z-ai model served via ZenMux, billed to that provider's own key). Kept
#   as a labelled slot, and to document the coding-vs-general split above.
# Signup: z.ai
ZHIPU_API_KEY=
# Used by: a CC roster peer you declare in ~/.genesis/config/cc_roster.local.yaml
#   — a GLM Coding Plan key for the INTERNATIONAL platform. Endpoints:
#   /api/anthropic and /api/coding/paas/v4; Claude Code speaks the Anthropic
#   protocol, so this is the one a roster peer needs. Coding endpoints may only
#   be used from provider-approved tools (Claude Code is one). Never give this
#   key to the router.
# Signup: z.ai
ZAI_CODING_API_KEY=
# Used by: a CC roster peer on the CHINA platform
#   (https://open.bigmodel.cn/api/anthropic) — the same thing as
#   ZAI_CODING_API_KEY but bought on bigmodel.cn, since a Coding Plan is not
#   portable between platforms. Distinct from ZHIPU_API_KEY on purpose: that is
#   the general/prepaid slot, and pointing it at /api/anthropic is precisely the
#   1113 failure above. The China platform requires real-name identity
#   verification (实名认证) to buy a Coding Plan.
# Signup: open.bigmodel.cn
BIGMODEL_CODING_API_KEY=

# --- Moonshot / Kimi (Kimi Code membership endpoint) ---
# Used by: the example CC roster peer `kimi-for-coding` (failover) in
#   config/cc_roster.yaml.
# Subscription-billed rather than per-token, so it suits a rate-limited primary
# rather than a cheaper one.
# _CODING_ in the name is the convention, not decoration: a roster peer talks to
# an Anthropic-protocol coding endpoint, and a general/prepaid key sent there
# returns `1113 Insufficient balance` on a funded account.
# Signup: kimi.com
KIMI_CODING_API_KEY=

# ─── AWS (EC2 install-test runner) ───────────────────────────────────────
# Used by: scheduler/install_test.py — provisions ephemeral VMs for weekly
#   install validation. Use an IAM user with EC2-only permissions.
# (AWS Bedrock model routing uses API_KEY_BEDROCK above, not these.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ─── Proxmox provisioning (optional) ─────────────────────────────────────
# Used by: provision_grow / provision_vzdump — privsep API tokens for a VM.
# Format: user@realm!tokenid=<uuid>. Non-secret config (host/node/vmid/storage)
#   lives in the host guardian.yaml, not here.
PROXMOX_AUDIT_TOKEN=
PROXMOX_PROVISION_TOKEN=

# ─── TestSprite (AI testing / in-loop verifier) ──────────────────────────
# Used by: TestSprite CLI (@testsprite/testsprite-cli) + MCP server for
#   in-loop test verification of generated code.
# Signup: testsprite.com (free tier available). Key: dashboard → Settings → API Keys.
TESTSPRITE_API_KEY=

# ─── Home Assistant media player (Voice PE) ──────────────────────────────
# HA_MEDIA_PLAYER_ENTITY: Voice PE media_player entity for proactive chimes.
#   Install-specific entity id (firmware adds a _media_player suffix); kept out
#   of committed source (same invariant as HA_VOICE_PE_PREFIX above).
HA_MEDIA_PLAYER_ENTITY=

# ─── Misc runtime config ─────────────────────────────────────────────────
# GENESIS_TIMEZONE: sets the container/host OS clock at INSTALL time only (via
#   `timedatectl` in bootstrap/host-setup). It is NOT read by the Genesis Python
#   runtime — display + scheduler timezone come from genesis.yaml `timezone`
#   (see USER_TIMEZONE above). Leave as-is unless you specifically need it.
GENESIS_TIMEZONE=UTC
# GENESIS_CC_PERMISSION_MODE: Claude Code permission mode for autonomous sessions
#   (e.g. 'bypass' to skip prompts). Leave unset for the default prompted mode.
GENESIS_CC_PERMISSION_MODE=
# CONTAINER: set to 1 on containerized installs (LXC/Docker) to enable
#   --no-sandbox for Playwright/Chromium. Leave unset on bare metal / VM.
CONTAINER=
