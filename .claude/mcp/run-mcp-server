#!/bin/bash
# Self-locating MCP server launcher.
# Resolves genesis root from this script's location — portable across machines.
# Usage: run-mcp-server --server <name>

set -euo pipefail

SCRIPT_DIR="$(unset CDPATH; cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GENESIS_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
MCP_SCRIPT="$GENESIS_ROOT/scripts/genesis_mcp_server.py"

# Find the Python venv. In a worktree, .venv lives in the main repo, not here.
# NOTE: resolved via git-common-dir, NOT `git worktree list | head -1` — under
# `set -o pipefail`, head closing the pipe SIGPIPEs git and kills this script
# with exit 141 (the exact bug that silently disabled genesis-hook in
# worktrees; bit the eval bench's worktree E2E the same way on 2026-07-09).
PYTHON="$GENESIS_ROOT/.venv/bin/python"
if [[ ! -x "$PYTHON" ]]; then
    COMMON_DIR="$(git -C "$GENESIS_ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    MAIN_ROOT="${COMMON_DIR%/.git}"
    if [[ -n "$MAIN_ROOT" && -x "$MAIN_ROOT/.venv/bin/python" ]]; then
        PYTHON="$MAIN_ROOT/.venv/bin/python"
    else
        echo "ERROR: Genesis venv not found at $GENESIS_ROOT/.venv/bin/python" >&2
        exit 1
    fi
fi

if [[ ! -f "$MCP_SCRIPT" ]]; then
    echo "ERROR: MCP server script not found: $MCP_SCRIPT" >&2
    exit 1
fi

# Shared-MCP rollout switch (scripts/lib/mcp_rollout.py). Only the form the
# Claude Code registrations use (`--server <name>`, nothing else) on an install
# that has opted in (the env stage, or the user overlay file) routes through it;
# every other spawn, Codex's --external-client among them, is the per-session
# server exactly as before. GENESIS_MCP_SHARED_DISABLED set to anything but 0
# turns it off.
ROLLOUT="$GENESIS_ROOT/scripts/lib/mcp_rollout.py"
_rollout_home="${GENESIS_HOME:-${HOME:-}/.genesis}"
if [[ $# -eq 2 && "$1" == --server && "${GENESIS_MCP_SHARED_DISABLED:-0}" == 0 && -f "$ROLLOUT" ]] \
    && [[ -n "${GENESIS_MCP_SHARED_STAGE+set}" || -e "$_rollout_home/config/mcp_shared.json" ]]; then
    exec "$PYTHON" -I -S "$ROLLOUT" launch --root "$GENESIS_ROOT" -- "$PYTHON" "$MCP_SCRIPT" "$@"
fi

exec "$PYTHON" "$MCP_SCRIPT" "$@"
