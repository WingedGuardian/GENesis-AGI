#!/usr/bin/env bash
# Launcher for codebase-memory-mcp MCP server, with a hard memory cap.
#
# WHY THE CAP: upstream v0.9.0 (latest as of 2026-07-12) still has an unbounded
# memory leak on query/read operations — DeusData/codebase-memory-mcp#581 is
# OPEN (0.9.0 landed memory-safety fixes but not the leak). Long-lived CC sessions grow
# an instance from ~10MB to multiple GB over hours/days; several concurrent
# sessions can exhaust a container's (or host's) RAM. Until upstream ships a
# fix, every instance runs inside a transient systemd scope with MemoryMax:
# the kernel kills it at the cap and the CC session degrades gracefully
# (other code-intel tools keep working; `/mcp` reconnects a fresh instance).
#
# --scope keeps the server a direct child of this launcher's replacement
# (systemd-run), so MCP stdio passes through untouched — only the cgroup
# membership changes.
#
# Install the tool first:
#   bash scripts/lib/cbm_installer.sh — a pinned, sha256-verified upstream installer.

# Machine-local kill switch. Registrations can survive process termination and
# bootstrap can drift-heal them later, so the launcher itself must enforce the
# disabled state. This is absent by default on new installations.
_user_home="${HOME:-}"
if [[ -z "$_user_home" ]]; then
    while IFS=: read -r _name _password _uid _gid _gecos _home _shell; do
        if [[ "$_uid" == "$EUID" ]]; then
            _user_home="$_home"
            break
        fi
    done < /etc/passwd
fi
_disable_file="${CODEBASE_MEMORY_MCP_DISABLE_FILE:-${_user_home:+${_user_home}/.genesis/codebase-memory-mcp.disabled}}"
# shellcheck disable=SC2088  # matching a LITERAL ~/ prefix is the point: the
# override arrived unexpanded, and this is where it gets expanded.
if [[ "$_disable_file" == "~/"* ]]; then
    # With no resolvable home this collapses to a relative path and the
    # absolute-path check below fails closed.
    _disable_file="${_user_home:+${_user_home}/}${_disable_file#\~/}"
fi
if [[ -z "$_disable_file" || "$_disable_file" != /* ]]; then
    printf 'run-codebase-memory: disable-state path must be absolute\n' >&2
    exit 1
fi
if [[ -e "$_disable_file" ]]; then
    printf 'run-codebase-memory: disabled by %s\n' "$_disable_file" >&2
    exit 1
fi

# Locate the binary WITHOUT depending on $HOME: some MCP clients
# spawn servers with a scrubbed environment (no HOME/USER/XDG_RUNTIME_DIR),
# where ${HOME}/.local/bin/... would collapse to /.local/bin/... and fail the
# -x check below (the client then reports a bare "write EPIPE"). Resolution
# order: explicit override, then the $HOME-based default, then PATH lookup
# (even scrubbed clients typically keep ~/.local/bin on PATH). Such clients
# also lack a reachable systemd user manager, so they take the ulimit
# fallback below instead of the cgroup cap.
BINARY="${CODEBASE_MEMORY_MCP_BIN:-}"
if [[ -z "$BINARY" ]]; then
    if [[ -n "${HOME:-}" && -x "${HOME}/.local/bin/codebase-memory-mcp" ]]; then
        BINARY="${HOME}/.local/bin/codebase-memory-mcp"
    elif command -v codebase-memory-mcp >/dev/null 2>&1; then
        BINARY="$(command -v codebase-memory-mcp)"
    fi
fi
MEM_MAX="${CODEBASE_MEMORY_MCP_MEMORY_MAX:-2G}"

if [[ -z "$BINARY" || ! -x "$BINARY" ]]; then
    printf 'codebase-memory-mcp not installed.\n' >&2
    printf 'Install: bash scripts/lib/cbm_installer.sh (pinned, sha256-verified upstream installer)\n' >&2
    exit 1
fi

# Preferred: cgroup cap via a transient scope. Probe first — exec has no
# fallback once taken, and systemd-run needs a reachable user manager (absent
# in some CI/containers). The probe sets the SAME properties as the real
# invocation so a property the manager rejects fails at probe time, not after
# exec. MemorySwapMax=0 keeps a future swap enablement from letting the leak
# thrash swap instead of being killed.
if command -v systemd-run >/dev/null 2>&1 \
    && systemd-run --user --scope --quiet \
        -p "MemoryMax=${MEM_MAX}" -p "MemorySwapMax=0" \
        -- /bin/true >/dev/null 2>&1; then
    # Named unit (issue #1792): anonymous scopes render as run-<id>.scope,
    # indistinguishable from CC session scopes — so this wrapper's by-design
    # cap kill could never be classified as contained by the OOM attribution
    # (tmp_watchgod.sh), and nothing could stop/freeze the scope by name.
    # $$ makes the name unique per launch (a fixed name collides with a stale
    # scope); the /bin/true probe above stays anonymous — it cannot OOM.
    exec systemd-run --user --scope --quiet \
        --unit "cbm-mcp-$$" \
        --description="codebase-memory-mcp (MemoryMax=${MEM_MAX})" \
        -p "MemoryMax=${MEM_MAX}" -p "MemorySwapMax=0" \
        -- "$BINARY" "$@"
fi

# Fallback: no usable user manager — bound the address space instead. Coarser
# than a cgroup cap (allocation failure instead of a clean kill), but still a
# hard ceiling. Accepts systemd-style <int>[.<frac>]G/M (case-insensitive),
# truncating any fraction; anything else runs uncapped with a warning rather
# than mis-capping (never let a malformed value become a bash arithmetic
# error on the MCP stderr).
if [[ "$MEM_MAX" =~ ^([0-9]+)(\.[0-9]+)?([GgMm])$ ]]; then
    _int="${BASH_REMATCH[1]}"
    case "${BASH_REMATCH[3]}" in
        G|g) _kb=$(( _int * 1024 * 1024 )) ;;
        *)   _kb=$(( _int * 1024 )) ;;
    esac
    ulimit -v "$_kb" 2>/dev/null \
        || printf 'run-codebase-memory: WARNING: could not apply ulimit -v %s\n' "$_kb" >&2
else
    printf 'run-codebase-memory: WARNING: unparseable CODEBASE_MEMORY_MCP_MEMORY_MAX=%s — running uncapped\n' "$MEM_MAX" >&2
fi
exec "$BINARY" "$@"
