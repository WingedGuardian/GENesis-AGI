#!/usr/bin/env bash
# GitNexus MCP launcher — refuse a binary that does not match the repository pin.
# Storage formats can change between releases. A stale reader cannot safely open
# an index written by a newer analyzer, and an unreviewed newer analyzer can make
# the index unreadable by the version Genesis supports.

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GENESIS_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
PIN_FILE="$GENESIS_ROOT/scripts/lib/gitnexus_version.sh"

if [ ! -r "$PIN_FILE" ]; then
    printf 'run-gitnexus: pin metadata unavailable; refusing to start\n' >&2
    exit 1
fi
# shellcheck source=../../scripts/lib/gitnexus_version.sh
if ! source "$PIN_FILE" \
    || [[ ! "${GENESIS_GITNEXUS_VERSION:-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
    || ! declare -F genesis_gitnexus_node_supported >/dev/null \
    || ! declare -F genesis_gitnexus_resolve_binary >/dev/null \
    || ! declare -F genesis_gitnexus_installed_is_pinned >/dev/null; then
    printf 'run-gitnexus: invalid pin metadata; refusing to start\n' >&2
    exit 1
fi

BINARY="$(genesis_gitnexus_resolve_binary 2>/dev/null || true)"
if [ -z "$BINARY" ] || [ ! -x "$BINARY" ]; then
    printf 'run-gitnexus: GitNexus is not installed\n' >&2
    exit 1
fi

if ! genesis_gitnexus_node_supported; then
    printf 'run-gitnexus: GitNexus %s does not support Node %s\n' \
        "$GENESIS_GITNEXUS_VERSION" "$(node --version 2>/dev/null || echo unavailable)" >&2
    exit 1
fi

actual="$("$BINARY" --version 2>/dev/null || true)"
if [ "${actual#v}" != "$GENESIS_GITNEXUS_VERSION" ]; then
    printf 'run-gitnexus: refusing unpinned GitNexus %s; expected %s\n' \
        "${actual:-unknown}" "$GENESIS_GITNEXUS_VERSION" >&2
    exit 1
fi

exec "$BINARY" "$@"
