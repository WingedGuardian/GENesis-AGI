#!/bin/bash
# Self-locating genesis hook launcher.
# Resolves genesis root from this script's location — portable across machines.
# Usage: genesis-hook <script_name.py> [args...]
#
# IMPORTANT: $CLAUDE_PROJECT_DIR is resolved by Claude Code in hook command
# strings (settings.json), but is NOT exported as a shell environment variable.
# Hook scripts that read os.environ["CLAUDE_PROJECT_DIR"] will get nothing.
# This launcher works around that by self-locating from its filesystem position.
# All hooks MUST go through this launcher — never read $CLAUDE_PROJECT_DIR directly.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GENESIS_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Resolve the MAIN worktree root ONCE — used for BOTH the venv fallback and the
# hook-script path. In a worktree, `git rev-parse --git-common-dir` gives the
# main repo's .git; its parent is the main worktree root. Do NOT use
# `git worktree list | head`: head closes the pipe after one line, so with many
# worktrees git gets SIGPIPE, and under `set -euo pipefail` that silently kills
# this launcher (exit 141, no stderr), breaking every hook in the worktree.
# Git's repository-LOCATION overrides, scrubbed in BOTH places below. An exported
# GIT_DIR / GIT_WORK_TREE / GIT_COMMON_DIR resolves an UNRELATED repo despite the
# `cd`, which would redirect every hook (security gates included) to a foreign
# checkout's same-named script.
#
# The last two are NOT location overrides: they change what a diff REPORTS from
# the right repository, which lands on the same decisions. MEASURED 2026-09-19:
# GIT_EXTERNAL_DIFF=/bin/true empties `git diff --cached`, so review_state's
# staged-content hash returns its "nothing staged" sentinel and the escalation
# cap stops counting rounds.
#
# This array is DUPLICATED as Python lists in scripts/review_state.py
# (GIT_ENV_UNSET), scripts/review_scope.py and
# src/genesis/session_awareness/zero_drop_git.py, because bash cannot import
# Python. tests/test_hooks/test_git_env_scrub.py parses it out of this file and
# asserts all four hold the same names, so a drift in any one fails naming it.
#
# IT CARRIES LOCATION VARIABLES ONLY, AND NO git CONFIG CHANNEL MAY BE ADDED —
# not the FILE sources (GIT_CONFIG_GLOBAL / GIT_CONFIG_SYSTEM) and not the
# injection channels (GIT_CONFIG_COUNT / GIT_CONFIG_PARAMETERS). All four are
# PROTECTED config, which is the only place git reads `safe.directory` from, so
# scrubbing any of them makes git refuse under a uid mismatch (a bind-mounted
# devcontainer, container CI, a hook under sudo) with EMPTY stdout — which the
# review gates' empty-output sentinel reads as "nothing staged".
#
# MEASURED 2026-09-20, one file staged, safe.directory supplied ONLY through
# GIT_CONFIG_COUNT, which is how a container or CI supplies it:
#   injected value present     rc=0    A staged.py
#   GIT_CONFIG_COUNT scrubbed  rc=129  (empty stdout) -> the gate reads "clean"
#
# And this launcher scrubs for all ~50 LAUNCHED hooks, one of which —
# git_push_guard — PREDICTS what a `git push` will do: its
# _push_config_is_simple is an allowlist over the user's effective config
# (remote.pushDefault, push.default, push.recurseSubmodules, …), where a
# broadening value makes it return False and PROMPT. MEASURED with a control
# that moves: with `push.default = matching` in ~/.gitconfig it returns False
# (prompts) when the config is visible and True — ALLOWS SILENTLY — once that
# config is scrubbed away. A guard that predicts a command's effect has to see
# the config that command will see.
#
# The config routes measured to move a gate decision are closed by FLAGS on the
# diff commands instead (--no-ext-diff, -c core.attributesFile=/dev/null): a
# flag cannot remove a capability the way an environment edit does.
_GIT_ENV_SCRUB=(
    -u GIT_DIR
    -u GIT_WORK_TREE
    -u GIT_INDEX_FILE
    -u GIT_COMMON_DIR
    -u GIT_OBJECT_DIRECTORY
    -u GIT_ALTERNATE_OBJECT_DIRECTORIES
    -u GIT_CEILING_DIRECTORIES
    -u GIT_DISCOVERY_ACROSS_FILESYSTEM
    -u GIT_NAMESPACE
    -u GIT_PREFIX
    -u GIT_EXTERNAL_DIFF
    -u GIT_DIFF_OPTS
)
_common_dir="$(cd "$GENESIS_ROOT" 2>/dev/null && env "${_GIT_ENV_SCRUB[@]}" git rev-parse --git-common-dir 2>/dev/null)" || _common_dir=""
MAIN_ROOT=""
if [[ -n "$_common_dir" ]]; then
    MAIN_ROOT="$(cd "$GENESIS_ROOT" 2>/dev/null && cd "$(dirname "$_common_dir")" 2>/dev/null && pwd)" || MAIN_ROOT=""
fi
# Trust MAIN_ROOT only if it actually looks like a Genesis checkout. A
# `--separate-git-dir` clone makes `--git-common-dir` point at external metadata
# whose parent is NOT the worktree root, which would send hooks to a bogus path;
# require a `scripts/` dir there, else fall back to GENESIS_ROOT (the non-worktree path).
if [[ -n "$MAIN_ROOT" && ! -d "$MAIN_ROOT/scripts" ]]; then
    MAIN_ROOT=""
fi

# Resolve the hook SCRIPT ROOT: the MAIN worktree by default, so every session
# runs the CURRENT hook + policy. Git-tracked hooks otherwise DRIFT per branch —
# a worktree session runs whatever hook version its branch froze until it rebases,
# so a worktree can enforce an OUTDATED security gate (measured 2026-08: 60 of 70
# worktrees ran a stale, warn-only full_suite_guard). Escape hatch:
# GENESIS_HOOK_DEV_LOCAL=1 runs the worktree's OWN copy — for deliberately testing
# a hook change live in-worktree; it is ANNOUNCED on stderr so it is never a
# silent downgrade of the whole session's gates. Fallback to GENESIS_ROOT when
# MAIN_ROOT is unresolvable (a non-worktree install, or not a git repo).
HOOK_ROOT="$GENESIS_ROOT"
if [[ -n "$MAIN_ROOT" && "${GENESIS_HOOK_DEV_LOCAL:-}" != "1" ]]; then
    HOOK_ROOT="$MAIN_ROOT"
elif [[ -n "$MAIN_ROOT" && "${GENESIS_HOOK_DEV_LOCAL:-}" == "1" ]]; then
    echo "genesis-hook: GENESIS_HOOK_DEV_LOCAL=1 — running the WORKTREE-local hook copy (not main-tree)" >&2
fi

# Find the Python venv, co-located with the hook tree (HOOK_ROOT) so the script
# and its interpreter/site-packages come from the SAME tree. A worktree rarely
# has its own .venv (worktrees never pip-install), so fall back to the other
# known roots rather than fail.
SCRIPT_NAME="${1:?Usage: genesis-hook <script_name.py|script_name.sh> [args...]}"
SCRIPT_PATH="$HOOK_ROOT/scripts/$SCRIPT_NAME"

# Choose the interpreter by the script's language. Every hook wired today is
# Python; a `.sh` hook runs under bash rather than being handed to the
# interpreter, which would fail on its shebang line.
#
# Resolved into a variable rather than exec'd per branch ON PURPOSE. The git
# scrub below has to sit on exactly ONE exec line, so a later refactor cannot
# drop it from one branch while the other still carries it —
# tests/test_hooks/test_git_env_scrub.py locks that shape, and it caught this
# file's first attempt at the change.
# A hook this launcher CANNOT RUN has cleared nothing, and exit 1 is
# non-blocking to Claude Code — so in a session that declares a Bash allowlist,
# every "cannot run" branch below would be a PERMIT. That is the exact silent
# downgrade the allowlist guard exists to remove, one layer up.
#
# MEASURED: with the guard absent from the resolved HOOK_ROOT (a lagging main
# worktree, a rollout, a --separate-git-dir clone that trips the MAIN_ROOT
# fallback), `genesis-hook hooks/bash_allowlist_guard.sh` exited 1 and the
# command proceeded.
#
# So: refuse (exit 2) when an allowlist is in force, and keep the ordinary
# non-blocking exit 1 otherwise. Scoped to allowlisted sessions on purpose —
# they are dispatched, never the repair path, so fail-closed here cannot
# strand an interactive session trying to fix the tree.
_cannot_run() {
    if [[ -n "${GENESIS_BASH_ALLOWLIST:-}" ]]; then
        echo "BLOCKED: this session restricts Bash to [$GENESIS_BASH_ALLOWLIST]," >&2
        echo "and the hook above could not be run, so nothing has been cleared." >&2
        exit 2
    fi
    exit 1
}

RUNNER=()
if [[ "$SCRIPT_NAME" == *.sh ]]; then
    RUNNER=(bash)
else
    # Find the Python venv, co-located with the hook tree (HOOK_ROOT) so the
    # script and its interpreter/site-packages come from the SAME tree. A
    # worktree rarely has its own .venv (worktrees never pip-install), so fall
    # back to the other known roots rather than fail.
    #
    # Resolved only for a Python hook: a shell hook needs no interpreter, and
    # exiting 1 here for one would fail OPEN — Claude Code treats a non-2 exit
    # as a non-blocking error, so the tool call proceeds. That is the wrong
    # direction for a shell hook that exists to REFUSE things.
    PYTHON=""
    for _root in "$HOOK_ROOT" "$MAIN_ROOT" "$GENESIS_ROOT"; do
        if [[ -n "$_root" && -x "$_root/.venv/bin/python" ]]; then
            PYTHON="$_root/.venv/bin/python"
            break
        fi
    done
    if [[ -z "$PYTHON" ]]; then
        echo "ERROR: Genesis venv not found (looked in HOOK_ROOT/MAIN_ROOT/GENESIS_ROOT/.venv/bin/python)" >&2
        echo "Run: cd $GENESIS_ROOT && python -m venv .venv && pip install -e ." >&2
        _cannot_run
    fi
    RUNNER=("$PYTHON")
fi

if [[ ! -f "$SCRIPT_PATH" ]]; then
    echo "ERROR: Hook script not found: $SCRIPT_PATH" >&2
    _cannot_run
fi

shift
# Scrub for the CHILD, not just for the discovery above. Until this was added,
# the launcher protected WHICH script runs and not what that script's own git
# queries see: a launched hook inherited an ambient GIT_DIR/GIT_WORK_TREE and
# resolved a foreign repository despite being handed an explicit cwd.
#
# MEASURED 2026-09-17, through this launcher, scratch repo A on `main` with 200
# staged lines against an unrelated repo B on `feat/decoy`. All four of the
# shared decision inputs the enforcement hooks rely on failed OPEN:
#
#   branch           main              -> feat/decoy   (defeats no-commits-to-main)
#   diff hash        24049b3cb26ddf73  -> "clean"      (staged work reads as none)
#   marker key       cb063e9bb05f      -> 5378b52a44c1 (a marker file that does not exist)
#   substantiality   substantial       -> inline       (downgrades required review depth)
#
# The Python modules scrub at their own git runners too, which is what covers a
# hook invoked directly from a shell rather than through this launcher. Both
# layers are deliberate: this one is the only thing that helps a hook that does
# NOT scrub, and that is every hook other than those two.
# The point of routing a shell hook through this launcher at all — rather than
# wiring its absolute path directly — is that it then inherits the SAME
# guarantees as the other ~55: HOOK_ROOT resolution to the MAIN worktree, so the
# hook cannot drift per branch (measured 2026-08: 60 of 70 worktrees ran a stale
# guard), and the git-location scrub. A security hook resolved by a second,
# parallel path is exactly the divergence those two properties exist to prevent.
exec env "${_GIT_ENV_SCRUB[@]}" "${RUNNER[@]}" "$SCRIPT_PATH" "$@"
