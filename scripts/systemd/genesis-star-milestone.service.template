[Unit]
Description=Genesis star-milestone watcher — wake work parked behind a star count
# Exists because a follow-up row whose revisit condition is "when we reach N
# stars" is a sentence, not a trigger: nothing evaluates it, so the row waits to
# be remembered. One API read a day turns it into an event.

[Service]
Type=oneshot
WorkingDirectory=__REPO_DIR__
ExecStart=__VENV__/bin/python __REPO_DIR__/scripts/star_milestone_check.py
# One unauthenticated HTTPS GET plus, on the rare crossing, a single SQLite
# insert. The script's own socket timeout is 30s, so this bound governs only the
# case where the process wedges somewhere the socket timeout cannot reach — DNS
# in a stuck resolver, or a database lock held by another writer.
#
# Per the project timeout floor (CLAUDE.md), a value below 2h needs a specific
# failure mode AND evidence. There is no evidence here to justify a tighter one,
# and the failure a tight bound would cause is worth naming: killed mid-run, the
# announcement is lost and the calendar timer does not retry until tomorrow. The
# cost of a generous bound is an idle process; the cost of a tight one is a
# missed wake-up, which is the only thing this unit does.
TimeoutStartSec=7200
Environment=PATH=__VENV__/bin:/usr/local/bin:/usr/bin:/bin
StandardOutput=journal
StandardError=journal
# Writes exactly two things: the observation (the database under the repo's data
# dir) and its own state file under ~/.genesis. ReadWritePaths=%h covers both
# without granting anything outside the home.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=%h

# No [Install] section, deliberately — driven only by its paired timer, matching
# genesis-cc-settings-align.service.template. The bootstrap loop enables
# *.timer.template generically; a WantedBy here would never be enabled and would
# tell a reader this also runs at boot.
