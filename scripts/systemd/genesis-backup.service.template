[Unit]
Description=Genesis Backup — Tier-1 encrypted push (+ Tier-2 off-site when configured)
After=genesis-server.service

[Service]
Type=oneshot
WorkingDirectory=__REPO_DIR__
# Before the backup, wait (up to the cap below) for its round-trip verify to
# fit in memory, so it does not rebuild the database on disk. "-": the wait
# only ever delays the backup, so a failure of it must not stop the run.
ExecStartPre=-/bin/bash __REPO_DIR__/scripts/backup_wait_for_ram.sh
ExecStart=/bin/bash __REPO_DIR__/scripts/backup.sh
# The wait's cap lives here, beside TimeoutStartSec, which bounds ExecStartPre
# too: the two always deploy together, and a unit without this line never waits.
Environment=GENESIS_BACKUP_VERIFY_WAIT_MAX_S=3600
# A large install's SQLite dump + GPG + Qdrant snapshots + Tier-2 upload over
# LAN can run well past the 90s default TimeoutStartSec, which would SIGTERM a
# healthy backup mid-encryption. Project floor (timeout policy): 2h for the run,
# plus the up-to-1h verify-memory wait above (TimeoutStartSec covers
# ExecStartPre: man systemd.service, "time out before the service is fully up").
TimeoutStartSec=10800
# Lowest best-effort I/O priority. A run's footprint is disk I/O (SQLite dump,
# GPG, Qdrant snapshots), not CPU: measured at under one core with CPU pressure
# near 1%, so nothing CPU-side is lowered. Not IOWeight=: that is a cgroup io
# setting, inert in a user unit unless the user manager has the io controller
# delegated (often only cpu/memory/pids are). This is per-process ioprio,
# inherited by every child backup.sh starts. MEASURED: the class reaches the
# unit's process and its children. UNVERIFIED: its effect on disk contention.
# Only BFQ weighs best-effort levels, and where the filesystem sits on
# device-mapper volumes (which have no scheduler of their own, BFQ being on the
# disks beneath) it is not established that the priority reaches BFQ.
# Best-effort 7, not idle: if it does take effect, idle could starve a run on a
# busy disk past the timeout above.
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# git push authenticates via ~/.gitconfig's `gh auth git-credential` helper
# (/usr/bin/gh, hosts.yml-backed) — no shell env or GH_TOKEN needed. sqlite3,
# gpg, curl, smbclient all live in the system paths below.
Environment=PATH=__VENV__/bin:/usr/local/bin:/usr/bin:/bin
# NOTE: no TMPDIR override. backup.sh routes its large intermediates to ~/tmp
# itself (GENESIS_BIG_TMP); pointing TMPDIR at the watchgod-policed cc-tmp
# would risk killing CC sessions on a big dump.
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
# No ProtectSystem=strict / ReadWritePaths sandbox here (unlike the watchdog and
# disk-hygiene units, which only touch $HOME). backup.sh orchestrates external
# tools that write OUTSIDE $HOME: gpg drives gpg-agent over its socket in
# /run/user/%U, and the Tier-2 COMPLETE marker uses a bare `mktemp` in /tmp —
# both are read-only under ProtectSystem=strict, so a hardened unit would fail
# Tier-1 encryption (non-deterministically, depending on whether gpg-agent is
# already alive) and the Tier-2 marker outright. The sandbox also delivers
# little for an unprivileged user unit that cannot write system paths regardless.
