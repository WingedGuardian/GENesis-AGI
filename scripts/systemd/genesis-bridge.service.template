[Unit]
Description=Genesis Telegram Bridge (CC conversation relay)
After=network.target
# Stop crash-looping: max 4 restarts in 120s, then give up until manual reset.
# Must be in [Unit], not [Service] — systemd 255 ignores them in [Service].
StartLimitBurst=4
StartLimitIntervalSec=120

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__
ExecStart=__VENV__/bin/python -m genesis.channels.bridge
Restart=on-failure
RestartSec=10

# Exit code 200 = "another instance holds the lock" — don't restart for that.
# Exit code 2 = "unconfigured" (missing secrets.env) — don't restart-loop.
# See genesis.util.process_lock.EXIT_ALREADY_RUNNING.
RestartPreventExitStatus=200 2

Environment="TMPDIR=__HOME__/.genesis/cc-tmp"
# SQLite reads SQLITE_TMPDIR before TMPDIR, so its temp spill files (etilqs_*,
# 100-200 MB sorts) land on the big disk while the Claude Code sessions this
# process launches keep TMPDIR on cc-tmp. Without it those spills fill the
# small cc-tmp volume and trip the runaway-file pager. MEASURED 2026-10-08 on
# SQLite 3.45.1: SQLITE_TMPDIR wins over TMPDIR; a missing directory falls back
# to TMPDIR with no error, and so does an unwritable one.
Environment="SQLITE_TMPDIR=__HOME__/tmp"
# ~/tmp is created on every update.sh run, but install.sh and bootstrap.sh create it
# only when /tmp is small: make sure it exists so the line above takes effect, and
# say so in the journal when it is not a usable directory. Deliberately NOT fatal:
# the fallback is the pre-SQLITE_TMPDIR behaviour (the disk guardian pages its
# spills), while a refusal to start would take the unit down over a temp directory.
# The step checks the SQLITE_TMPDIR systemd already resolved from the line above,
# read from the environment: the directory checked is the one SQLite gets, and no
# install value is ever parsed as shell or Exec-line syntax. `$$` and `%%` are
# systemd's escapes for a literal `$` and `%`.
ExecStartPre=-/bin/sh -c 'd="$$SQLITE_TMPDIR"; mkdir -p "$$d"; [ -d "$$d" ] && [ -w "$$d" ] && [ -x "$$d" ] || printf "SQLITE_TMPDIR %%s is not a writable directory: SQLite temp files fall back to TMPDIR\n" "$$d" >&2'
# The boot repair (#3492 D2a-2): the installed kit judges the update state before
# the service starts, and heals a `live` checkout a killed switch left
# half-written (scripts/lib/live_move_repair.py). Only its 75 (a tree it judged
# half-written and could not heal) and a signal death (any status 129-255) refuse the start; anything
# else (no kit, a crash, its self-check's 3) starts, with a journal line and,
# while an update state exists, a page. TimeoutStartSec bounds the pre-steps; the
# kit ends every child by its own 75 s deadline inside it (live_move_boot.py).
# A kit from before this step (no live_move_boot.py, e.g. one a rollback
# reinstalled) exits 1 where this one exits 75, so its 1 refuses too.
TimeoutStartSec=90
# The kit's pages name this unit (%N: its name without .service).
Environment=GENESIS_BOOT_UNIT=%N
ExecStartPre=/bin/sh -c 's="$$1/.genesis/update_state.json"; d=$$(cd -P "$$1/.genesis/lib/live-repair/current" 2>/dev/null && pwd) || d=; rc=none; if [ -n "$$d" ] && [ -f "$$d/live_move_repair.py" ]; then python3 -I -S -B "$$d/live_move_repair.py" --boot "$$s" "$$2"; rc=$$?; [ "$$rc" != 1 ] || [ -f "$$d/live_move_boot.py" ] || rc=75; fi; case $$rc in 0) exit 0 ;; 75|129|1[3-9][0-9]|2[0-4][0-9]|25[0-5]) exit $$rc ;; esac; echo "live-move repair: the kit could not run (exit $$rc); boot repair skipped, the service starts" >&2; if [ -e "$$s" ]; then q="$$d/alert_queue.sh"; [ -n "$$d" ] && [ -f "$$q" ] || q="$$2/scripts/lib/alert_queue.sh"; timeout -k 1 3 bash -c "$$3" alert "$$q" "the boot repair could not run (exit $$rc)" "The service started without its boot repair while an update state exists. Reinstall the kit: python3 -I -S $$2/scripts/lib/live_repair_kit.py install $$2 $$1" "live_move_repair:boot:kit:$$rc:$${d##*/}" >/dev/null 2>&1 || :; fi; exit 0' -- "__HOME_EXEC__" "__REPO_EXEC__" '. "$$1" && queue_alert critical live_move_repair "$$2" "$$3" "$$4"'
Environment=PATH=__VENV__/bin:__CC_BIN_DIR__:__HOME__/.npm-global/bin:__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TG_ADAPTER=v2
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=%h

[Install]
WantedBy=default.target
