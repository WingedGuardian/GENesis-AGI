[Unit]
Description=Genesis Code-Intelligence Runner — idle-gated index-request consumer
After=genesis-server.service

[Service]
Type=oneshot
# Startup resolves its checkout from the absolute captured entry path. Native
# indexers select their repository cwd explicitly.
WorkingDirectory=/
ExecStart=:/bin/sh -c 'exec "$@"' -- "__VENV_EXEC__/bin/python" -I "__REPO_EXEC__/scripts/lib/code_intel_source.py" shell runner runner
# The runner runs the index FOREGROUND under a pressure watchdog whose full-mode
# wall cap is 4h; keep the unit timeout comfortably above that so a legitimately
# throttled (duty-cycled) full rebuild is never SIGTERMed mid-flight. A wedged
# runner is still bounded by its own self-flock (one tick at a time).
TimeoutStartSec=16200
# PATH MUST include BOTH tool dirs: gitnexus lives in ~/.npm-global/bin, and
# codebase-memory-mcp installs to ~/.local/bin (the vendor install.sh default,
# cf. .claude/mcp/run-codebase-memory). If either is absent from the unit PATH
# the entrypoint exits 3 ("requested tool missing") and the runner keeps the
# marker instead of silently stamping a fake success — which is exactly what
# happened when ~/.local/bin was omitted: cbm indexing was dead for days while
# gitnexus kept working. Also needs systemctl/systemd-run (the watchdog's
# cgroup freeze), flock, ps, awk, git (/usr/bin) and the venv python.
# __CC_BIN_DIR__ is the resolved npm prefix bin — it doubles as the nvm
# fallback's bin dir, so a Node/GitNexus installed under ~/.nvm stays visible
# to the timer instead of every index being refused off the system PATH.
Environment="PATH=__VENV_EXEC__/bin:__CC_BIN_EXEC__:__HOME_EXEC__/.npm-global/bin:__HOME_EXEC__/.local/bin:/usr/local/bin:/usr/bin:/bin"
# Retain the renderer's literal selection for managed loaded-command validation.
Environment="VENV_PATH=__VENV_EXEC__"
StandardOutput=journal
StandardError=journal
# Writes only under $HOME (index-request markers + locks under ~/.genesis, the
# cbm cache under ~/.cache, .gitnexus + .codebase-memory under ~/genesis).
# NOT NoNewPrivileges: the entrypoint's systemd-run --user --scope wants an
# unrestricted path to the user manager for the watchdog's freeze/thaw/stop.
ProtectSystem=strict
ReadWritePaths=%h

[Install]
WantedBy=default.target
