[Unit]
Description=Genesis FalkorDB — graph engine for the memory graph (socket-only)
# The memory graph's engine (issue #1641): SQLite stays the system of record,
# this holds a DERIVED, rebuildable index. The memory graph reads it only when
# config/graphstore.yaml selects `mode: falkordb` (default: networkx), so this
# unit is rendered by bootstrap but NOT auto-enabled, the same posture as
# genesis-code-intel-freeze. Arm it deliberately:
#   systemctl --user enable --now genesis-falkordb
#   systemctl --user disable --now genesis-falkordb
#
# scripts/lib/falkordb_install.sh fetches the released module under
# ~/.genesis/deps. redis-server >= 8.0.0 is an operator step (SETUP.md): the
# module refuses to load on the 7.x that Ubuntu/Debian stable ship.
#
# StartLimit* live in [Unit], NOT [Service]: systemd ignores
# StartLimitIntervalSec there (it accepts StartLimitBurst as a legacy alias, so
# the misplacement is HALF-silent and leaves burst counting against the 10s
# manager default). Measured: with RestartSec=5 and a 10s window, burst=4 is
# unreachable and a unit whose module fails to load restarts forever without
# ever entering `failed` — which is also what the posture rule assumes cannot
# happen. No network.target: this service opens no socket on the network.
StartLimitBurst=4
StartLimitIntervalSec=120

[Service]
# notify, not simple: with Type=simple systemd reports the unit active as soon
# as it FORKS, and the socket is not answering yet. MEASURED on the reference
# install, 3 restarts per config with the start limiter respected: Type=simple
# was not ready immediately 3/3 times (61ms, 147ms, 78ms), Type=notify 0/3.
# The posture rule reads "unit active + socket missing" as a fault, so that
# window is a false alert waiting to fire; --supervised systemd below is what
# makes redis send the readiness notification that closes it.
Type=notify
# Type=notify can hang where Type=simple could not: redis only sends READY=1
# when built with libsystemd, and USE_SYSTEMD=yes is NOT redis's Makefile
# default -- so a source build accepts --supervised systemd and never notifies.
# Bound it well under the 90s manager default, so such a build fails fast into
# the restart limiter instead of parking a start job for a minute and a half.
TimeoutStartSec=20
# Socket-only by design: --port 0 disables the TCP listener entirely, so this
# never collides with an operator's own redis on 6379 and is not reachable off
# the box. Readers connect over the unix socket.
#
# No persistence (--save "" --appendonly no): the graph is a projection of
# memory_links and the recovery path is to re-project, not to restore. That is
# also why backup.sh does not cover it — same reasoning it already applies to
# Qdrant, whose snapshot is an optimisation rather than a correctness need.
#
# --maxmemory is set BELOW the cgroup MemoryMax on purpose. It bounds the
# allocator, but RSS runs ~1.6-2.0x the allocator figure (measured during the
# engine evaluation), so a 1gb maxmemory could reach ~1.8G RSS and be OOM-killed
# by the cgroup before redis's own limit ever engaged. 512mb keeps worst-case
# RSS around the 1G ceiling and is still ~6x the measured peak for this graph's
# size. noeviction: silently evicting graph keys would corrupt the projection —
# a write that cannot fit must fail loudly and be repaired by a re-project.
# `+` runs this one command outside the sandbox below: ReadWritePaths names
# the data dir itself, a missing ReadWritePaths entry fails namespace setup,
# and under ProtectHome=read-only a sandboxed mkdir could not create it.
#
# Paths are quoted items built on %h, never a rendered $HOME: systemd splits
# unquoted whitespace into separate arguments (systemd.service(5) "Command
# Lines", systemd.syntax(7) "Quoting"), and %h is expanded per item, so a home
# with a space stays one argument. __REDIS_SERVER__ arrives escaped for these
# quotes by _falkordb_redis_server_bin.
ExecStartPre=+/bin/mkdir -p "%h/.genesis/falkordb"
ExecStart="__REDIS_SERVER__" \
    --port 0 \
    --unixsocket "%h/.genesis/falkordb/falkordb.sock" \
    --unixsocketperm 700 \
    --dir "%h/.genesis/falkordb" \
    --loadmodule "%h/.genesis/deps/falkordb/__FALKORDB_VERSION__/falkordb.so" \
    --save "" \
    --appendonly no \
    --maxmemory 512mb \
    --maxmemory-policy noeviction \
    --supervised systemd
Restart=always
RestartSec=5
# Budgeted on RSS, not on the allocator figure. Note this only bites where the
# memory controller is delegated to the user slice; --maxmemory above is the
# backstop that holds regardless.
MemoryMax=1G
LimitNOFILE=65536
# No OOMScoreAdjust: lowering oom_score_adj needs CAP_SYS_RESOURCE, which an
# unprivileged `systemd --user` manager does not have. systemd treats the
# failure as non-fatal, so the directive would sit here reporting itself as
# configured (via `systemctl show`) while the process keeps the manager's
# inherited score. Measured: the running engine had oom_score_adj=100, the
# same as the user manager. Real protection needs a drop-in on user@.service.
NoNewPrivileges=yes
ProtectSystem=strict
# ProtectSystem=strict does NOT cover /home, /root or /run/user: systemd's
# strict table leaves them writable for ProtectHome= to manage (src/core/
# namespace.c, protect_system_strict_table). Without ProtectHome the allowlist
# below narrows nothing and the repo and its secrets.env, ~/.ssh and ~/.claude
# all stay writable. --save "" does not close that: an explicit BGSAVE after
# CONFIG SET dir writes wherever dir points, and the module is native code.
# So the home is read-only and the data dir is the one writable path. The
# module under ~/.genesis/deps only needs to be READ.
#
# BEST-EFFORT under a user manager: since systemd 254 these filesystem
# directives imply PrivateUsers=yes in a user unit (systemd NEWS, 254), so
# they need unprivileged user namespaces, and where those are denied (common
# in unprivileged containers) systemd skips them and the unit runs
# unsandboxed (issue #2824). PrivateUsers=yes is deliberately NOT set: on 254+
# it adds nothing the implicit form does not, and an EXPLICIT request is one
# systemd may refuse to run without (its executor has a fatal "Failed to set up
# user namespacing" path beside the implicit form's "..., ignoring"), turning a
# host without user namespaces from unsandboxed into a unit that never starts.
ProtectHome=read-only
ReadWritePaths="%h/.genesis/falkordb"
RestrictAddressFamilies=AF_UNIX
PrivateTmp=yes
ProtectKernelTunables=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
