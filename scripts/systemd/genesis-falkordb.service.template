[Unit]
Description=Genesis FalkorDB — graph engine for the memory graph (socket-only)
# The memory graph's engine (issue #1641): SQLite stays the system of record,
# this holds a DERIVED, rebuildable index. The memory graph reads it only when
# config/graphstore.yaml selects `mode: falkordb` (default: networkx), so this
# unit is rendered by bootstrap but NOT auto-enabled, the same posture as
# genesis-code-intel-freeze. Arm it deliberately:
#   systemctl --user enable --now genesis-falkordb
#   systemctl --user disable --now genesis-falkordb
#
# The engine ships as the hash-pinned `falkordblite` wheel. Provisioning
# (scripts/lib/falkordb_install.sh) verifies the installed files against the
# digests committed in scripts/lib/falkordb-engine-digests.txt and runs them
# from a COPY, never from the venv: ~/.genesis/deps/falkordb/<version>-<wheel
# tag>/, rendered here as absolute paths. The directory name changes with the
# pin, so a pin bump lands beside this unit's files instead of on top of them.
# A deploy moves this unit onto a new copy only when systemd reports it inactive
# or failed; a running engine, or one whose state cannot be read, takes
# `GENESIS_FALKORDB_SWITCH=1 scripts/bootstrap.sh` and a restart of this unit.
#
# StartLimit* live in [Unit], NOT [Service]: systemd ignores
# StartLimitIntervalSec there (it accepts StartLimitBurst as a legacy alias, so
# the misplacement is HALF-silent and leaves burst counting against the 10s
# manager default). Measured: with RestartSec=5 and a 10s window, burst=4 is
# unreachable and a unit whose module fails to load restarts forever without
# ever entering `failed` — which is also what the posture rule assumes cannot
# happen. No network.target: this service opens no socket on the network.
StartLimitBurst=4
StartLimitIntervalSec=120

[Service]
# simple plus a readiness poll, not notify. The wheel's redis-server is built
# WITHOUT libsystemd, so under Type=notify + --supervised systemd it never sends
# READY=1 and every start times out (MEASURED). Plain Type=simple alone reports
# the unit active as soon as it FORKS, before the socket answers (MEASURED on
# the reference install: not ready 3/3 restarts, 61-147ms), and the posture
# rule reads "unit active + socket missing" as a fault. The ExecStartPost below
# closes that window: the start job completes only once the engine answers
# PING over its socket (MEASURED: about 0.5 s after Starting).
Type=simple
# Bounds the whole start, the readiness poll included (15 s of polling at most),
# well under the 90s manager default, so an engine that never answers fails
# fast into the restart limiter instead of parking a start job.
TimeoutStartSec=20
# Socket-only by design: --port 0 disables the TCP listener entirely, so this
# never collides with an operator's own redis on 6379 and is not reachable off
# the box. Readers connect over the unix socket.
#
# No persistence (--save "" --appendonly no): the graph is a projection of
# memory_links and the recovery path is to re-project, not to restore. That is
# also why backup.sh does not cover it — same reasoning it already applies to
# Qdrant, whose snapshot is an optimisation rather than a correctness need.
#
# --maxmemory is set BELOW the cgroup MemoryMax on purpose. It bounds the
# allocator, but RSS runs ~1.6-2.0x the allocator figure (measured during the
# engine evaluation), so a 1gb maxmemory could reach ~1.8G RSS and be OOM-killed
# by the cgroup before redis's own limit ever engaged. 512mb keeps worst-case
# RSS around the 1G ceiling and is still ~6x the measured peak for this graph's
# size. noeviction: silently evicting graph keys would corrupt the projection —
# a write that cannot fit must fail loudly and be repaired by a re-project.
#
# --slowlog-max-len and --latency-monitor-threshold keep the engine's own record
# of a slow moment: a read that times out client-side is otherwise news with no
# cause. SLOWLOG times each command including its wait for a worker thread;
# LATENCY catches a stalled main thread, which SLOWLOG cannot see. The default
# 128 entries held about 2.5 h, nearly all hourly projection batches (MEASURED
# 2026-10-20: about 47 entries an hour), so 4096 keeps about three days.
# `+` runs this one command outside the sandbox below: ReadWritePaths names
# the data dir itself, a missing ReadWritePaths entry fails namespace setup,
# and under ProtectHome=read-only a sandboxed mkdir could not create it.
#
# Paths are quoted items built on %h, never a rendered $HOME: systemd splits
# unquoted whitespace into separate arguments (systemd.service(5) "Command
# Lines", systemd.syntax(7) "Quoting"), and %h is expanded per item, so a home
# with a space stays one argument. __REDIS_SERVER__, __REDIS_CLI__,
# __FALKORDB_MODULE__ and __FALKORDB_DIGESTS__ arrive escaped for these quotes
# (and with `%` doubled) by falkordb_install.sh, which refuses a path holding
# `"`, `\`, `$` or a control character.
ExecStartPre=+/bin/mkdir -p "%h/.genesis/falkordb"
# Integrity at EVERY start, not only at provision time: the copy's
# engine.sha256 holds the digest of each engine file (binaries and the
# libraries the module links), written by falkordb_engine_check.py after it
# matched them to the committed digests. A file changed since then fails the
# start here, before redis runs (MEASURED with a changed byte). --strict also
# fails a malformed line. This catches DRIFT, not the engine itself: the
# sandbox below is best-effort (where it is skipped, the engine could write the
# copy), so the integrity check that holds is the re-verify against committed
# digests at every provision.
ExecStartPre=/usr/bin/sha256sum --quiet --strict -c "__FALKORDB_DIGESTS__"
ExecStart="__REDIS_SERVER__" \
    --port 0 \
    --unixsocket "%h/.genesis/falkordb/falkordb.sock" \
    --unixsocketperm 700 \
    --dir "%h/.genesis/falkordb" \
    --loadmodule "__FALKORDB_MODULE__" \
    --save "" \
    --appendonly no \
    --maxmemory 512mb \
    --maxmemory-policy noeviction \
    --slowlog-max-len 4096 \
    --latency-monitor-threshold 100
# Readiness: the start job completes only once the engine answers PING over its
# socket, polled up to 150 times at 0.1 s; otherwise the start fails. systemd
# expands `%` specifiers and `$` variables in command lines (systemd.service(5)
# "Command lines"), so every shell `$` is written `$$`, and the script uses no
# `%`. The redis-cli path and the socket are passed as positional arguments,
# never spliced into the script, so a path is never parsed as shell. This line
# runs BEFORE the projector trigger below: ExecStartPost lines run in order, and
# the projector must start only once the engine answers.
ExecStartPost=/bin/sh -c 'i=0; while [ "$$i" -lt 150 ]; do [ "$$("$$1" -s "$$2" PING 2>/dev/null)" = PONG ] && exit 0; i=$$((i + 1)); sleep 0.1; done; echo "graph engine did not answer PING on $$2" >&2; exit 1' falkordb-ready "__REDIS_CLI__" "%h/.genesis/falkordb/falkordb.sock"
# Re-project on EVERY start, restarts included (issue #3035). The engine keeps
# no persistence, so a restarted engine holds no graph, and every traversal
# fell back until the hourly timer next fired: up to an hour, with the first
# fallback in each process costing a multi-second NetworkX rebuild. The timer's
# Persistent=true does not help: it catches up runs missed while the TIMER was
# inactive, not an engine that lost its data.
#   restart, not start: if the hourly projection is mid-run when the engine
#     dies, that run is writing into the engine that just lost everything, and
#     a `start` of an already-activating oneshot merges into it and runs
#     nothing new (MEASURED on a scratch oneshot, 2026-11-04). `restart` stops
#     it (the projector unwinds on SIGTERM, graphstore_project.py) and runs a
#     fresh projection; on an idle projector it is a plain start.
#   --no-block: the projector unit orders After= this one, so it is queued and
#     runs once this start completes; waiting for it here would deadlock.
#   `-`: a failed trigger never fails the engine's own start.
#   `+`: outside the sandbox below, like the mkdir, so the call reaches the
#     user manager's bus whatever namespacing the sandbox ends up applying.
#   One retry after 2 s, so a transient bus hiccup does not leave the engine
#   empty until the hourly timer (which stays the bound if both attempts fail;
#   systemd logs the failed command either way).
ExecStartPost=-+/bin/sh -c '/usr/bin/systemctl --user restart --no-block genesis-graph-project.service || { sleep 2; /usr/bin/systemctl --user restart --no-block genesis-graph-project.service; }'
Restart=always
RestartSec=5
# Budgeted on RSS, not on the allocator figure. Note this only bites where the
# memory controller is delegated to the user slice; --maxmemory above is the
# backstop that holds regardless.
MemoryMax=1G
LimitNOFILE=65536
# No OOMScoreAdjust: lowering oom_score_adj needs CAP_SYS_RESOURCE, which an
# unprivileged `systemd --user` manager does not have. systemd treats the
# failure as non-fatal, so the directive would sit here reporting itself as
# configured (via `systemctl show`) while the process keeps the manager's
# inherited score. Measured: the running engine had oom_score_adj=100, the
# same as the user manager. Real protection needs a drop-in on user@.service.
NoNewPrivileges=yes
ProtectSystem=strict
# ProtectSystem=strict does NOT cover /home, /root or /run/user: systemd's
# strict table leaves them writable for ProtectHome= to manage (src/core/
# namespace.c, protect_system_strict_table). Without ProtectHome the allowlist
# below narrows nothing and the repo and its secrets.env, ~/.ssh and ~/.claude
# all stay writable. --save "" does not close that: an explicit BGSAVE after
# CONFIG SET dir writes wherever dir points, and the module is native code.
# So the home is read-only and the data dir is the one writable path. The
# engine copy under ~/.genesis/deps only needs to be READ.
#
# BEST-EFFORT under a user manager: since systemd 254 these filesystem
# directives imply PrivateUsers=yes in a user unit (systemd NEWS, 254), so
# they need unprivileged user namespaces, and where those are denied (common
# in unprivileged containers) systemd skips them and the unit runs
# unsandboxed (issue #2824). PrivateUsers=yes is deliberately NOT set: on 254+
# it adds nothing the implicit form does not, and an EXPLICIT request is one
# systemd may refuse to run without (its executor has a fatal "Failed to set up
# user namespacing" path beside the implicit form's "..., ignoring"), turning a
# host without user namespaces from unsandboxed into a unit that never starts.
ProtectHome=read-only
ReadWritePaths="%h/.genesis/falkordb"
RestrictAddressFamilies=AF_UNIX
PrivateTmp=yes
ProtectKernelTunables=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
