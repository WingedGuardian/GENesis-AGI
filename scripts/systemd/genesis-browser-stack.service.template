[Unit]
Description=Genesis browser stack — install the Camoufox engine, the fallback's Chromium and their system libraries
# No [Install] section: an operator starts this unit (and, once installs enable it,
# its timer), never login. A run that has nothing to do exits in seconds.

[Service]
Type=oneshot
WorkingDirectory=__REPO_DIR__
ExecStart=/bin/bash "__REPO_DIR__/scripts/install_browser_stack.sh"
# The whole run: up to four steps (engine fetch, add-ons, Chromium, system
# libraries) at the project's 2 h floor each (genesis-development, Timeout
# Policy). No hang has been observed; the engine download is about 1.3 GB. The
# module cuts every step's timeout to what is left of this, so steps that each
# stay inside their own limit cannot together be killed mid-install.
TimeoutStartSec=28800
Environment="PATH=__VENV__/bin:/usr/local/bin:/usr/bin:/bin"
# No environment file: install_browser_stack.sh reads the browser settings it needs
# from secrets.env by name, so no other secret reaches the downloaders.
StandardOutput=journal
StandardError=journal
# Writes only under $HOME: the engine cache, Playwright's browser cache, the
# download temp files (~/tmp, set by the module for its child processes only) and
# the runner lock. NoNewPrivileges makes `sudo -n` fail, so a missing system
# library is reported with the command to run instead of being installed here.
ProtectSystem=strict
ReadWritePaths=%h
NoNewPrivileges=true
