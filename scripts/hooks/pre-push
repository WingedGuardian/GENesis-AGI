#!/usr/bin/env python3
"""Enter the native chain without introducing shell startup/environment effects."""
import os
import sys
from pathlib import Path

os.execv(  # noqa: S606 — preserve the native process environment and argv
    sys.executable,
    [sys.executable, str(Path(__file__).resolve().with_name("pre_push_chain.py")), "--", *sys.argv[1:]],
)
