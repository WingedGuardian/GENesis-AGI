#!/bin/bash
# Native outer protocol: empty stdout on allow, exit 2 on every other result.
# An explained deny writes fd3 so the launch-owned command can distinguish it
# from a failure before this wrapper completes; configuration wiring is later.
rc=0
decision=
# An unresolvable hook directory falls through to the final explained denial.
if hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd); then
    decision=$(python3 "$hook_dir/codex_validator_guard.py" "$@") || rc=$?
else
    rc=2
fi
if [ "$rc" -eq 0 ] && [ "$decision" = "allow" ]; then
    exit 0
fi
if [ "$rc" -eq 2 ] && [ "$decision" = "deny" ]; then
    { printf 'deny\n' >&3; } 2>/dev/null
    exit 2
fi
printf '%s\n' 'BLOCKED: Validator action evaluation did not allow this action.' >&2
{ printf 'deny\n' >&3; } 2>/dev/null
exit 2
