#!/bin/bash
# Codex continues after ordinary hook failures. Convert evaluator failure to an
# explicit deny, including missing/broken Python imports. Never emit ask JSON.
#
# Exit 2 with "deny" on stdout is a decision the evaluator has already explained
# on stderr (fix-and-retry, or stop for the user); adding a second, generic STOP
# here made every fixable denial read as a dead end. Any OTHER outcome (a crash,
# a missing or unreadable evaluator, which python3 also reports as exit 2, or a
# result that is neither "allow" nor "deny") is a failure of this guard, and stops.
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 2
decision=$(python3 "$hook_dir/codex_review_stop.py")
rc=$?
if [ "$rc" -eq 0 ] && [ "$decision" = "allow" ]; then
    exit 0
fi
if [ "$rc" -eq 2 ] && [ "$decision" = "deny" ]; then
    exit 2
fi
printf '%s\n' 'BLOCKED: Codex review-budget evaluation did not allow this action. Stop and handoff to the user.' >&2
exit 2
